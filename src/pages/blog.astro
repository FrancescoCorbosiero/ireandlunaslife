---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { IG_URL, IG_HANDLE, SITE_NAME } from '../config';
import { autoCover } from '../lib/images';

const all = await getCollection('articoli');
// In evidenza: mai un coming-soon senza link, la cui pagina di dettaglio non viene buildata.
const featured =
  all.find((a) => a.data.featured) ??
  all.find((a) => a.data.status === 'published' && !a.data.externalUrl) ??
  all[0];
const statusOrder: Record<string, number> = { published: 0, 'coming-soon': 1 };
const rest = all
  .filter((a) => a.id !== featured?.id)
  .sort(
    (a, b) =>
      statusOrder[a.data.status] - statusOrder[b.data.status] ||
      b.data.date.getTime() - a.data.date.getTime()
  );

const f = featured?.data;
const fExternal = Boolean(f?.externalUrl);
const fLinkable = Boolean(f && (f.externalUrl || f.status === 'published'));
const fHref = f?.externalUrl ?? (featured && fLinkable ? `/blog/${featured.id}` : null);
const FTag = fHref ? 'a' : 'div';
const fCover = featured && f ? autoCover('articolo', featured.id, f.cover) : undefined;

// Categorie reali presenti, per i filtri client-side della griglia.
const categorie = [...new Set(rest.map((a) => a.data.category))];
---
<Base
  active="blog"
  title={`Il blog · ${SITE_NAME}`}
  description="Il blog di Irene e Luna: consigli, esperienze e pensieri per chi vuole crescere con il proprio cane."
  ogTitle={`Il blog · ${SITE_NAME}`}
  ogDescription="Consigli, esperienze e pensieri per chi vuole crescere con il proprio cane."
  ogImage="/assets/articolo-il-mio-viaggio-nel-mondo-della-cinofilia.jpg"
  ogImageAlt="Luna che corre in un campo"
  ogImageWidth={1440}
  ogImageHeight={960}
>
  <!-- INTRO -->
  <section class="section-tight">
    <div class="container">
      <div class="head-block" data-reveal style="max-width:760px;">
        <span class="eyebrow kicker-rule">Il blog</span>
        <h1 class="display-xl">Il diario di <span class="script">Ire &amp; Luna.</span></h1>
        <p class="lead">
          Consigli, esperienze e pensieri per chi vuole crescere con il proprio cane.
        </p>
      </div>
    </div>
  </section>

  <!-- FEATURED ARTICLE -->
  {
    featured && f && (
      <section class="section-tight">
        <div class="container">
          <FTag
            class="svc-block"
            {...fHref ? { href: fHref } : {}}
            {...fExternal ? { target: '_blank', rel: 'noopener' } : {}}
            data-reveal
            style="text-decoration:none;"
          >
            {fCover ? (
              <div
                class="svc-block-media parallax-cover"
                transition:name={fLinkable && !fExternal ? `art-img-${featured.id}` : undefined}
              >
                <img src={fCover} alt={f.coverAlt ?? f.title} loading="lazy" decoding="async" data-parallax data-parallax-cover />
              </div>
            ) : (
              <div
                class="svc-block-media placeholder"
                style="min-height:280px; flex-direction:column; gap:8px;"
              >
                <span>{f.placeholderLabel ?? 'FOTO'}</span>
              </div>
            )}
            <div class="svc-block-body">
              <div class="card-meta">
                <span style="color:var(--coral-deep);">In evidenza</span> · <span>{f.category}</span>
              </div>
              <h2 class="display-md" transition:name={fLinkable && !fExternal ? `art-${featured.id}` : undefined}>
                {f.title}
              </h2>
              <p>{f.excerpt}</p>
              {
                fLinkable ? (
                  <span class="text-link">
                    {fExternal ? 'Leggi su Instagram' : "Leggi l'articolo"} <ArrowIcon size={14} />
                  </span>
                ) : (
                  <span class="text-link" style="opacity:0.55; cursor:default;">
                    Presto disponibile
                  </span>
                )
              }
            </div>
          </FTag>
        </div>
      </section>
    )
  }

  <!-- GRID + FILTRI + RICERCA (appare dal secondo articolo in poi) -->
  {rest.length === 0 ? (
  <section class="section-tight bg-paws">
    <div class="container">
      <p class="field-hint" data-reveal>
        Nuovi articoli in arrivo. Nel frattempo, le avventure di tutti i giorni sono su Instagram:
        <a class="text-link" href={IG_URL} target="_blank" rel="noopener">{IG_HANDLE}</a>.
      </p>
    </div>
  </section>
  ) : (
  <section class="section-tight bg-paws">
    <div class="container">
      <div class="blog-toolbar" data-reveal>
        <div class="blog-filters" data-blog-filters role="group" aria-label="Filtra per categoria">
          <button class="chip is-active" type="button" data-cat="*" aria-pressed="true">Tutti</button>
          {
            categorie.map((c) => (
              <button class="chip" type="button" data-cat={c} aria-pressed="false">
                {c}
              </button>
            ))
          }
        </div>
        <label class="blog-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
            <path d="m20 20-3.8-3.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <input
            type="search"
            placeholder="Cerca nel blog…"
            data-blog-search
            aria-label="Cerca negli articoli per titolo o argomento"
            autocomplete="off"
          />
        </label>
      </div>
      <div class="card-grid cols-3 stagger" data-blog-grid data-reveal data-delay="1">
        {rest.map((entry) => <ArticleCard entry={entry} />)}
      </div>
      <div class="blog-empty" data-blog-empty hidden>
        <p style="margin:0 0 12px;">
          Nessun articolo trovato. Prova con un'altra parola (es. “cucciolo”, “passeggiata”,
          “ciotola”)…
        </p>
        <button class="btn btn-ghost btn-sm" type="button" data-blog-reset>Mostra tutti gli articoli</button>
      </div>
      <p class="visually-hidden" role="status" aria-live="polite" data-blog-count></p>
      <p class="field-hint" style="margin-top:20px;">
        Le avventure di tutti i giorni sono prima su Instagram. Seguici su <a
          class="text-link"
          href={IG_URL}
          target="_blank"
          rel="noopener">{IG_HANDLE}</a
        >.
      </p>
    </div>
  </section>
  )}

  <!-- CTA -->
  <section class="section-tight bg-teal paper-bg" style="background-color:var(--teal);">
    <div class="container container-narrow">
      <div class="cta-band">
        <h2 class="display-md">Hai una domanda<br />sul tuo cane?</h2>
        <p class="lead">
          Spesso la risposta più utile arriva da un confronto diretto. Scrivimi: ti rispondo io.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/contatti#scrivimi">Chiedi a me</a>
        </div>
      </div>
    </div>
  </section>
</Base>
